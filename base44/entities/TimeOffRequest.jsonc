{
  "name": "TimeOffRequest",
  "type": "object",
  "properties": {
    "business_owner_email": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "vacation",
        "sick",
        "personal",
        "other"
      ],
      "default": "vacation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "business_owner_email",
    "start_date",
    "end_date"
  ]
}