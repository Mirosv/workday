    },
    "business_phone": {
      "type": "string",
      "default": "3093151754"
    },
    "business_address": {
      "type": "string",
      "default": "61753"
    },
    "default_labor_rate": {
      "type": "number",
      "default": 0
    },
    "default_overhead_pct": {
      "type": "number",
      "default": 0
    },
    "default_profit_pct": {
      "type": "number",
      "default": 0
    },
    "language": {
      "type": "string",
