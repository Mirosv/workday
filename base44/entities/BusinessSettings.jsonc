{
  "name": "BusinessSettings",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string"
    },
    "business_name": {
      "type": "string",
      "default": "Mi Empresa"
    },
    "business_phone": {
      "type": "string",
      "default": ""
    },
    "business_address": {
      "type": "string",
      "default": ""
    },
    "logo_url": {
      "type": "string",
      "default": ""
    },
    "default_labor_rate": {
      "type": "number",
      "default": 0
    },
    "default_overhead_pct": {
      "type": "number",
      "default": 0
    },
    "default_profit_pct": {
      "type": "number",
      "default": 0
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "es"
      ],
      "default": "en"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "premium"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "deleted"
      ],
      "default": "active"
    },
    "plan_expires_at": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "business_name"
  ]
}