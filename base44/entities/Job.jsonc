{
  "name": "Job",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "job_name": {
      "type": "string"
    },
    "job_address": {
      "type": "string"
    },
    "total_price": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "estimate",
        "in_progress",
        "paid",
        "cancelled"
      ],
      "default": "lead"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        }
      }
    },
    "labor_rate": {
      "type": "number",
      "default": 0
    },
    "labor_hours": {
      "type": "number",
      "default": 0
    },
    "overhead_pct": {
      "type": "number",
      "default": 0
    },
    "profit_pct": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "minimum_fee": {
      "type": "number",
      "default": 0
    },
    "equipment_wear": {
      "type": "number",
      "default": 0
    },
    "equipment_wear_on": {
      "type": "boolean",
      "default": false
    },
    "materials_consumables": {
      "type": "number",
      "default": 0
    },
    "materials_on": {
      "type": "boolean",
      "default": false
    },
    "disposal_fees": {
      "type": "number",
      "default": 0
    },
    "disposal_on": {
      "type": "boolean",
      "default": false
    },
    "travel_mobilization": {
      "type": "number",
      "default": 0
    },
    "travel_on": {
      "type": "boolean",
      "default": false
    },
    "business_name": {
      "type": "string"
    },
    "business_phone": {
      "type": "string"
    },
    "business_address": {
      "type": "string"
    },
    "grand_total": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "client_name",
    "job_name"
  ]
}