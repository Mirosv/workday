{
  "name": "Expense",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "job_id": {
      "type": "string",
      "default": ""
    },
    "job_name": {
      "type": "string",
      "default": ""
    },
    "category": {
      "type": "string",
      "enum": [
        "materials",
        "fuel",
        "tools",
        "labor",
        "disposal",
        "other"
      ],
      "default": "other"
    }
  },
  "required": [
    "name",
    "amount"
  ]
}