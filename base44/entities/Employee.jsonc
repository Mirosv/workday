{
  "name": "Employee",
  "type": "object",
  "properties": {
    "business_owner_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "employee"
      ],
      "default": "employee"
    },
    "position": {
      "type": "string"
    },
    "hourly_rate": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "lunch_break_minutes": {
      "type": "number",
      "default": 30,
      "description": "Minutos de lunch a descontar por turno"
    },
    "lunch_paid": {
      "type": "boolean",
      "default": false,
      "description": "Si es true, el lunch se paga y NO se descuenta de las horas"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "business_owner_email"
  ]
}